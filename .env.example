# TMDB API key (v3 auth). Get one at https://www.themoviedb.org/settings/api
# Server-only — never prefix with NEXT_PUBLIC_ (that would inline it into the client bundle).
TMDB_API_KEY=your_tmdb_api_key_here

# Postgres connection string. Matches the credentials in compose.yaml (npm run db:up).
DATABASE_URL=postgresql://moviemania:moviemania@localhost:5434/moviemania

# Secret used to sign session cookies (HS256). Generate one with: openssl rand -base64 32
SESSION_SECRET=generate_with_openssl_rand_base64_32
